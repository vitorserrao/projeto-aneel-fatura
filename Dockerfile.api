FROM python:3.12-slim

WORKDIR /app

COPY infra_lab/requirements.lab.txt /app/requirements.lab.txt
RUN pip install --no-cache-dir -r requirements.lab.txt

COPY api api
COPY core core
COPY infra infra
COPY schemas schemas
COPY scripts scripts

EXPOSE 8000

CMD ["uvicorn", "api.main_lab:app", "--host", "0.0.0.0", "--port", "8000"]
